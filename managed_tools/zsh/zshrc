# Set the command search path: own tools first, then Homebrew, then the system.
typeset -U path PATH  # Keep entries unique; the first occurrence wins.
path=(
    $HOME/.local/bin $HOME/bin $HOME/opt/bin
    /opt/homebrew/bin /opt/homebrew/sbin
    /usr/local/bin /usr/local/sbin
    /usr/bin /bin /usr/sbin /sbin
    $path
)
path=($^path(N-/))  # Drop entries that aren't existing directories.
export PATH

# Attach to tmux or start it, before the rest of the setup so it isn't loaded twice.
# Skip it inside tmux, without a terminal, for `zsh -i -c ...`, in VS Code, and in
# Claude Code and the Claude desktop app.
if (( $+commands[tmux] )) \
    && [[ -z $TMUX ]] \
    && [[ -t 0 && -t 1 && -z $ZSH_EXECUTION_STRING ]] \
    && [[ "$VSCODE_RESOLVING_ENVIRONMENT" != "1" && "$TERM_PROGRAM" != "vscode" ]] \
    && [[ -z $CLAUDECODE && "$TERM_PROGRAM" != "claude-desktop" ]] ; then
    if tmux has &> /dev/null ; then
        exec tmux attach
    else
        exec tmux new -s tmux
    fi
fi

# Enable Powerlevel10k instant prompt, which shows the prompt while the rest of this file
# loads. Code that may need console input (e.g., password prompts, [y/n] confirmations)
# must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]] ; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Set environment variables.
export EDITOR="vim"
export ZSH=~/.oh-my-zsh
export PIP_REQUIRE_VIRTUALENV=true

# Use hyphen-insensitive completion. _ and - will be interchangeable.
HYPHEN_INSENSITIVE=true

# Do not throw any error if a pattern for filename generation has no matches.
unsetopt NOMATCH

# Set theme. Its prompt segments are configured in `p10k.zsh`, loaded below.
ZSH_THEME="powerlevel10k/powerlevel10k"

# Set plugins to load.
plugins=(
    # Syntax-highlight file contents of over 300 supported languages and other text
    # formats.
    colorize  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/colorize

    # Helpful shortcut aliases for many commonly used commands.
    common-aliases  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/common-aliases

    # Add the `Ctrl-O` shortcut to copy the current text in the command line to the
    # system clipboard.
    copybuffer  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/copybuffer

    # Put the contents of a file in the system clipboard.
    copyfile  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/copyfile

    # Copy the path of given directory or file to the system clipboard.
    copypath  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/copypath

    # Find the Google Cloud SDK and enable `gcloud` completions.
    gcloud  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/gcloud

    # Pull `gitignore.io` templates from the command line.
    gitignore  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/gitignore

    # Helpful utilities to access a few macOS applications from the terminal.
    macos  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/macos

    # Add the `ESC + man` shortcut to insert `man` before the previous command.
    man  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/man

    # Add several aliases for useful Python commands.
    python  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/python

    # Prefix current or previous commands with `sudo` by pressing `ESC` twice.
    sudo  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/sudo

    # Add the `ESC + tldr` shortcut to insert `tldr` before the previous command.
    tldr  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/tldr

    # Generate `rclone` completions from the installed version, in case zsh's own
    # completions miss newer flags.
    # rclone  # https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/rclone
)

# Disable `url-quote-magic`.
DISABLE_MAGIC_FUNCTIONS=true

# Add completions installed by Homebrew (e.g., for `aws`, `brew`, `uv`). They're
# appended, so zsh's own completions (e.g., for `git`) take precedence.
fpath+=(/opt/homebrew/share/zsh/site-functions(N-/))

# Load `oh-my-zsh`.
source "$ZSH/oh-my-zsh.sh"

# Configure the Powerlevel10k prompt. Run `p10k configure` to change it.
source ~/.p10k.zsh

# Map various keys to custom functionality.
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^[OM" accept-line  # keypad Enter
bindkey "^[OA" history-beginning-search-backward-end  # Up arrow (application mode)
bindkey "^[[A" history-beginning-search-backward-end  # Up arrow (normal mode)
bindkey "^[OB" history-beginning-search-forward-end  # Down arrow (application mode)
bindkey "^[[B" history-beginning-search-forward-end  # Down arrow (normal mode)
bindkey "^[[H" beginning-of-line  # Home (normal mode)
bindkey "^[OH" beginning-of-line  # Home (application mode)
bindkey "^[[1~" beginning-of-line  # Home (tmux)
bindkey "^[[F" end-of-line  # End (normal mode)
bindkey "^[OF" end-of-line  # End (application mode)
bindkey "^[[4~" end-of-line  # End (tmux)
bindkey "^[[1;3D" backward-word  # Alt + Left arrow (xterm style, e.g., on Linux)
bindkey "^[[1;3C" forward-word  # Alt + Right arrow (xterm style, e.g., on Linux)

# Raise the open-files soft limit without ever exceeding the hard cap.
if [[ "$(ulimit -Hn)" = "unlimited" ]] ; then
    ulimit -Sn 65536            # pick a sane soft limit
else
    ulimit -Sn "$(ulimit -Hn)"  # raise soft limit up to hard limit
fi

# Set colors for the GNU ls utility and for zsh completion. On macOS, this needs GNU
# coreutils (`gls`, `gdircolors`).
case "$OSTYPE" in
    darwin*)
        if (( $+commands[gls] )) ; then
            eval `gdircolors ~/.dircolors`
            alias ls="gls -F --color=auto --ignore $'Icon\r'"
        fi
        ;;
    linux*)
        eval `dircolors ~/.dircolors`
        alias ls="ls -F --color=auto"
        ;;
esac
zstyle ":completion:*" list-colors ${(s.:.)LS_COLORS}

# Name frequent directories, so that they work in any path (e.g., `cp file ~down/`) and
# show up shortened in the prompt.
hash -d work=~/work
hash -d dotf=~/work/dotfiles
hash -d desk=~/Desktop
hash -d down=~/Downloads

# Let `cd` find repos in `~/work` from anywhere (e.g., `cd notebooks`). Directories
# relative to the current one take precedence.
cdpath=(~/work)

# Define additional aliases and functions.
# TODO(stefanistrate): Improve these aliases.
alias yt="yt-dlp 720p"
alias -g 480p="--format 'bestvideo[height<=480]+bestaudio'"
alias -g 720p="--format 'bestvideo[height<=720]+bestaudio'"
alias -g 1080p="--format 'bestvideo[height<=1080]+bestaudio'"
alias -g 2160p="--format 'bestvideo[height<=2160]+bestaudio'"
alias -g LIVE="--live-from-start"
alias -g MP3="--format 'bestaudio' --extract-audio --audio-format mp3"
alias -g MP4="--recode-video mp4"
alias -g SUB="--write-subs --write-auto-subs"
alias -g COOK="--cookies-from-browser chrome"
alias -g PLIST="-o '[%(playlist_index)s] %(title)s [%(id)s].%(ext)s'"

# Enable local settings, which override general settings.
if [[ -f ~/.zshrc.local ]] ; then
    source ~/.zshrc.local
fi
