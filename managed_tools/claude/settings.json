{
  "cleanupPeriodDays": 3650,
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",

      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(sshpass *)",
      "Bash(rsync *)",

      "Edit(**/.git/**)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git send-pack *)",
      "Bash(git http-push *)",
      "Bash(git send-email *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git -c *)",
      "Bash(git * foreach *)",
      "Bash(git credential*)",
      "Bash(git * credential*)",
      "Bash(git-credential-*)",

      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(earthengine *)",
      "Bash(az *)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "notebook@notebook": true
  },
  "extraKnownMarketplaces": {
    "notebook": {
      "source": {
        "source": "github",
        "repo": "echo-labs-org/notebook-plugin"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "light",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg"
      ],
      "denyWrite": [
        "**/.git"
      ]
    }
  }
}
